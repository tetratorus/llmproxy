# llmproxy local dev env — copy to .env and fill in.
# Tests use these directly; running agents do NOT (they pass keys per-request).

# Required for /claude tests:
ANTHROPIC_API_KEY=

# Required for /deepseek tests:
DEEPSEEK_API_KEY=

# Required for /kimi tests (Moonshot AI — global endpoint api.moonshot.ai):
MOONSHOT_API_KEY=

# Optional overrides:
# PORT=8181
# LLMPROXY_DB=requests.db
